# Timelime Backend Environment Variables
# Copy this file to .env and fill in your values for local development

# Google Cloud Platform
GCP_CREDENTIALS=path/to/your/gcp-credentials.json
BUCKET=your-gcp-bucket-name

# OpenAI API
OPENAI_API_KEY=your-openai-api-key-here

# Stripe Payment
STRIPE=your-stripe-api-key-here
STRIPE_WEBHOOK=your-stripe-webhook-secret-here

# SendGrid Email
SENDGRID_API_KEY=your-sendgrid-api-key-here

# Application
FE_URL=http://localhost:3000
CONTACT_EMAIL=your-contact-email@example.com
ADMIN_EMAIL=your-admin-email@example.com

# Local Development (Optional)
# These are used by config.py's set_env_vars() function
# Set these to automatically load credentials from files during local development
LOCAL_DEV_CREDENTIALS_PATH=path/to/your/local/gcp-credentials.json
LOCAL_OPENAI_KEY_PATH=path/to/your/local/openai.json
